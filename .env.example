# Optional settings for connected mode. Copy to .env.
# On first launch, use `npm start` to explore without any of these.

# The starter binds ONLY to loopback; do not expose the server on the LAN.
PORT=4173

# Leave unconfigured services blank: they display UNCONFIGURED, not RUNNING.
# Each must be a loopback HTTP URL: http://127.0.0.1:PORT
HERMES_BASE_URL=
FLINT_BASE_URL=
MISSION_CONTROL_BASE_URL=

# Optional gateway API key. Read on the server only; never put secrets in VITE_*.
HERMES_API_KEY=

# Experimental model chat. DISABLED by default.
# Only point this at a *plain inference server without tools*.
# Never connect this chat adapter to an autonomous agent executor.
ALLOW_LOCAL_CHAT=0
MODEL_BASE_URL=
MODEL_ID=
MODEL_API_KEY=
